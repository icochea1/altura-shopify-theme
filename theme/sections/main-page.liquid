<div class="page-hero">
  <div class="container container--narrow">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="h2">{{ page.title }}</h1>
  </div>
</div>
<section class="section" style="padding-top:0">
  <div class="container container--narrow rte article-body" style="font-size:1.05rem">{{ page.content }}</div>
</section>
{% schema %}
{ "name": "Page content", "settings": [{ "type": "text", "id": "eyebrow", "label": "Eyebrow" }] }
{% endschema %}
