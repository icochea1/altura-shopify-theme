<section class="section {{ section.settings.style }}">
  <div class="container">
    <div class="split{% if section.settings.reverse %} split--reverse{% endif %}">
      <div class="split__media" data-reveal>
        <div class="media">
          {%- if section.settings.image -%}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: section.settings.image.alt }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
        </div>
        {%- if section.settings.image_2 -%}
          <div class="split__media-small" data-reveal style="--d:3">{{ section.settings.image_2 | image_url: width: 700 | image_tag: loading: 'lazy', alt: '' }}</div>
        {%- endif -%}
      </div>
      <div class="split__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 data-reveal style="--d:1">{{ section.settings.title }}</h2>
        <div class="lead rte" data-reveal style="--d:2">{{ section.settings.text }}</div>
        {%- if section.blocks.size > 0 -%}
          <div class="stats" data-reveal style="--d:3">
            {%- for block in section.blocks -%}
              <div {{ block.shopify_attributes }}><div class="stat__num">{{ block.settings.number }}</div><div class="stat__label">{{ block.settings.label }}</div></div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn {% if section.settings.style == 'section--dark' %}btn--light{% endif %}" data-reveal style="--d:4">{{ section.settings.button_label }} {% render 'icon', name: 'arrow-right', size: 16 %}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_2", "label": "Overlapping image" },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Coffee that pays it forward" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We buy directly from 42 family farms across the Peruvian Andes and pay an average of 2.4× the fair-trade minimum.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read our story" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "style", "label": "Background", "default": "", "options": [ { "value": "", "label": "Default" }, { "value": "section--surface", "label": "Surface" }, { "value": "section--dark", "label": "Dark" } ] }
  ],
  "blocks": [{ "type": "stat", "name": "Stat", "limit": 3, "settings": [
    { "type": "text", "id": "number", "label": "Number", "default": "42" },
    { "type": "text", "id": "label", "label": "Label", "default": "Partner farms" }
  ] }],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
