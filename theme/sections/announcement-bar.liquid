<div class="announcement" data-announcement>
  <div class="container announcement__inner">
    {%- for block in section.blocks -%}
      <div class="announcement__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon, size: 15 %}{%- endif -%}
        <span>{{ block.settings.text }}</span>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $60" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "none", "label": "None" }, { "value": "truck", "label": "Truck" }, { "value": "leaf", "label": "Leaf" },
          { "value": "gift", "label": "Gift" }, { "value": "flame", "label": "Flame" }, { "value": "refresh", "label": "Subscription" }
        ] },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
