{%- assign sid = section.id -%}
<section class="section {{ section.settings.style }}">
  <div class="container" data-rail-wrap>
    <div class="section-head" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.title }}</h2>
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="tabs" role="tablist" data-tabs>
          {%- for block in section.blocks -%}
            <button class="tab" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="Panel-{{ sid }}-{{ forloop.index }}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title }}</button>
          {%- endfor -%}
        </div>
      {%- elsif section.settings.layout == 'rail' -%}
        <div class="rail-nav">
          <button data-rail-prev aria-label="Previous">{% render 'icon', name: 'arrow-left', size: 18 %}</button>
          <button data-rail-next aria-label="Next">{% render 'icon', name: 'arrow-right', size: 18 %}</button>
        </div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      <div class="tab-panel" id="Panel-{{ sid }}-{{ forloop.index }}" role="tabpanel" {% unless forloop.first %}hidden{% endunless %}>
        {%- if section.settings.layout == 'rail' -%}
          <div class="rail" style="--cols: {{ section.settings.columns }}">
            {%- for product in col.products limit: section.settings.limit -%}
              {% render 'product-card', product: product, index: forloop.index0 %}
            {%- else -%}
              {%- for i in (1..4) -%}<div class="card"><div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div><div class="card__info"><span class="card__title">Product title</span></div></div>{%- endfor -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="product-grid" style="--cols: {{ section.settings.columns }}">
            {%- for product in col.products limit: section.settings.limit -%}
              {% render 'product-card', product: product, index: forloop.index0 %}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}

    {%- if section.settings.layout == 'rail' -%}<div class="rail-progress"><span></span></div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="center" style="margin-top:44px" data-reveal>
        <a href="{{ section.settings.button_link | default: section.blocks.first.settings.collection.url }}" class="btn btn--outline">{{ section.settings.button_label }} {% render 'icon', name: 'arrow-right', size: 16 %}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "This week's roast" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Fresh from the roaster" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "rail", "options": [ { "value": "rail", "label": "Slider" }, { "value": "grid", "label": "Grid" } ] },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all coffee" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "style", "label": "Background", "default": "", "options": [ { "value": "", "label": "Default" }, { "value": "section--surface", "label": "Surface" } ] }
  ],
  "blocks": [
    { "type": "collection", "name": "Collection tab", "limit": 5, "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "label", "label": "Tab label" }
    ] }
  ],
  "presets": [{ "name": "Featured collection", "blocks": [{ "type": "collection" }] }]
}
{% endschema %}
