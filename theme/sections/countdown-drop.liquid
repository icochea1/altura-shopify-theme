<section class="section section--tight">
  <div class="container">
    <div class="drop" data-reveal>
      {%- if section.settings.image -%}{{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', widths: '800, 1200, 1600, 2000', alt: '' }}{%- endif -%}
      <div class="drop__inner">
        <p class="eyebrow" style="color:#E9B48F">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.title }}</h2>
        <p style="opacity:.8;max-width:46ch">{{ section.settings.text }}</p>
        <div class="countdown" data-countdown="{{ section.settings.end }}" aria-label="Time left">
          <div class="countdown__unit"><b data-cd="d">00</b><span>Days</span></div>
          <div class="countdown__unit"><b data-cd="h">00</b><span>Hours</span></div>
          <div class="countdown__unit"><b data-cd="m">00</b><span>Min</span></div>
          <div class="countdown__unit"><b data-cd="s">00</b><span>Sec</span></div>
        </div>
        {%- if section.settings.product != blank -%}
          {%- assign p = section.settings.product -%}
          <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center">
            <a href="{{ p.url }}" class="btn btn--light">{{ section.settings.button_label }} {% render 'icon', name: 'arrow-right', size: 16 %}</a>
            <span style="opacity:.8">From {{ p.price_min | money }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Countdown drop",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited release · 120 bags" },
    { "type": "text", "id": "title", "label": "Heading", "default": "The Geisha drop" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Jasmine, white peach and bergamot. Our rarest lot of the year." },
    { "type": "text", "id": "end", "label": "End date (YYYY-MM-DD HH:MM)", "info": "If empty or in the past, a rolling 3-day timer is shown.", "default": "2026-12-01 09:00" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Reserve a bag" }
  ],
  "presets": [{ "name": "Countdown drop" }]
}
{% endschema %}
