{%- assign m = product.metafields.custom -%}
{%- if m.tasting_notes != blank or section.settings.always -%}
<section class="section section--dark">
  <div class="container">
    <div class="section-head" data-reveal>
      <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.title }}</h2></div>
      <p class="lead" style="margin:0">{{ section.settings.text }}</p>
    </div>
    <div class="guide" data-reveal style="--d:1">
      {%- for block in section.blocks -%}
        <div class="guide__step" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon, size: 26 %}
          <b>{{ block.settings.value }}</b>
          <span>{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Brew recipe strip",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Recipe" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Our go-to pour-over" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Dialed in by our head roaster for this lot." },
    { "type": "checkbox", "id": "always", "label": "Show on non-coffee products", "default": false }
  ],
  "blocks": [{ "type": "step", "name": "Step", "limit": 4, "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "default": "scale", "options": [
      { "value": "scale", "label": "Scale" }, { "value": "droplet", "label": "Water" }, { "value": "thermometer", "label": "Temperature" }, { "value": "clock", "label": "Time" } ] },
    { "type": "text", "id": "value", "label": "Value", "default": "15 g" },
    { "type": "text", "id": "label", "label": "Label", "default": "Coffee, medium-fine" }
  ] }]
}
{% endschema %}
