{%- assign blog = section.settings.blog -%}
<section class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.title }}</h2></div>
      {%- if blog -%}<a href="{{ blog.url }}" class="link-arrow">Read the journal {% render 'icon', name: 'arrow-right', size: 16 %}</a>{%- endif -%}
    </div>
    <div class="journal">
      {%- for article in blog.articles limit: 3 -%}
        {% render 'article-card', article: article, index: forloop.index0 %}
      {%- else -%}
        {%- for i in (1..3) -%}<div class="post-card"><div class="media">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div><h3>Journal post</h3></div>{%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Stories from the source" }
  ],
  "presets": [{ "name": "Journal" }]
}
{% endschema %}
