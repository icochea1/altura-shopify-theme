<div class="page-hero">
  <div class="container"><p class="eyebrow">Journal</p><h1 class="h2">{{ blog.title }}</h1><p class="lead">{{ section.settings.text }}</p>
    {%- if blog.all_tags.size > 0 -%}
      <div class="chip-row" style="justify-content:center;margin-top:24px">
        <a class="chip" href="{{ blog.url }}"{% if current_tags == blank %} style="background:var(--c-text);color:var(--c-bg)"{% endif %}>All</a>
        {%- for tag in blog.all_tags -%}<a class="chip" href="{{ blog.url }}/tagged/{{ tag | handleize }}"{% if current_tags contains tag %} style="background:var(--c-text);color:var(--c-bg)"{% endif %}>{{ tag }}</a>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
<section class="section" style="padding-top:0">
  <div class="container">
    {%- paginate blog.articles by 9 -%}
      <div class="journal">
        {%- for article in blog.articles -%}{%- assign idx = forloop.index0 | modulo: 3 -%}{% render 'article-card', article: article, index: idx %}{%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="center" style="margin-top:40px">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Blog posts", "settings": [{ "type": "textarea", "id": "text", "label": "Intro", "default": "Brew guides, farm visits and notes from the roastery." }] }
{% endschema %}
