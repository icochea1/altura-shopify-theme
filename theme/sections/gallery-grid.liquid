<section class="section">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.title }}</h2>
    </div>
    <div class="gram">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: settings.social_instagram }}" target="_blank" rel="noopener" data-reveal style="--d: {{ forloop.index0 }}" {{ block.shopify_attributes }} aria-label="Open on Instagram">
          {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 16vw, 33vw', widths: '300, 450, 600', alt: '' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          {% render 'icon', name: 'instagram', size: 26 %}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social gallery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "@altura.coffee" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Brewed by you" }
  ],
  "blocks": [{ "type": "image", "name": "Image", "limit": 12, "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "url", "id": "link", "label": "Link" }
  ] }],
  "presets": [{ "name": "Social gallery", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
