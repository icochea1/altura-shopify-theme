<section class="section {{ section.settings.style }}">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.title }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}<a href="{{ routes.collections_url }}" class="link-arrow">{{ section.settings.link_label }} {% render 'icon', name: 'arrow-right', size: 16 %}</a>{%- endif -%}
    </div>
    <div class="collection-tiles{% if section.settings.bento %} collection-tiles--bento{% endif %}" style="--cols: {{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a href="{{ c.url | default: '#' }}" class="tile" data-reveal style="--d: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- assign img = block.settings.image | default: c.featured_image -%}
          {%- if img -%}{{ img | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '500, 800, 1100, 1400', alt: c.title }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          <div style="width:100%">
            <h3 class="tile__title">{{ block.settings.title | default: c.title | default: 'Collection' }}</h3>
            <div class="tile__count"><span>{{ c.products_count | default: 0 }} products</span><span class="tile__arrow">{% render 'icon', name: 'arrow-right', size: 16 %}</span></div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Find your ritual" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All collections" },
    { "type": "checkbox", "id": "bento", "label": "Bento layout", "default": true },
    { "type": "select", "id": "style", "label": "Background", "default": "", "options": [ { "value": "", "label": "Default" }, { "value": "section--surface", "label": "Surface" } ] }
  ],
  "blocks": [{ "type": "collection", "name": "Collection", "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "title", "label": "Custom title" },
    { "type": "image_picker", "id": "image", "label": "Custom image" }
  ] }],
  "presets": [{ "name": "Collection list", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
