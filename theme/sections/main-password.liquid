<section class="hero" style="min-height:100svh;display:flex;align-items:center">
  <div class="hero__media" style="position:absolute;inset:0">
    {%- if section.settings.image -%}{{ section.settings.image | image_url: width: 2200 | image_tag: alt: '' }}{%- endif -%}
  </div>
  <div class="container" style="position:relative;z-index:2;text-align:center">
    <p class="eyebrow" style="color:#E9B48F">{{ shop.name }}</p>
    <h1 class="hero__title">{{ section.settings.title }}</h1>
    <p class="hero__sub" style="margin:0 auto 2em">{{ shop.password_message | default: section.settings.text }}</p>
    {%- form 'customer', class: 'newsletter__form', style: 'max-width:480px;margin:0 auto' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}<p style="margin:0 auto;padding:10px 16px">You're on the list.</p>{%- else -%}
      <input type="email" name="contact[email]" required placeholder="Email for early access" aria-label="Email">
      <button class="btn btn--light" type="submit">Notify me</button>{%- endif -%}
    {%- endform -%}
    <details style="margin-top:28px;opacity:.85">
      <summary style="cursor:pointer;font-size:.9rem">Store owner? Enter password</summary>
      {%- form 'storefront_password', class: 'newsletter__form', style: 'max-width:420px;margin:16px auto 0' -%}
        <input type="password" name="password" placeholder="Password" aria-label="Password" autocomplete="current-password">
        <button class="btn btn--light" type="submit">Enter</button>
        {%- if form.errors -%}<p>{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Opening soon" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Specialty coffee from the high Andes of Perú." }
  ]
}
{% endschema %}
