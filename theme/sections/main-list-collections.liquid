<div class="page-hero"><div class="container"><p class="eyebrow">Shop</p><h1 class="h2">{{ section.settings.title }}</h1></div></div>
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="collection-tiles" style="--cols: 3">
      {%- for c in collections -%}
        {%- if c.handle == 'frontpage' or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
        <a href="{{ c.url }}" class="tile" data-reveal style="--d: {{ forloop.index0 | modulo: 3 }}">
          {%- if c.image -%}{{ c.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: c.title }}{%- elsif c.products.first.featured_image -%}{{ c.products.first.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: c.title }}{%- endif -%}
          <div style="width:100%"><h2 class="tile__title">{{ c.title }}</h2><div class="tile__count"><span>{{ c.products_count }} products</span><span class="tile__arrow">{% render 'icon', name: 'arrow-right', size: 16 %}</span></div></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Collections list", "settings": [{ "type": "text", "id": "title", "label": "Heading", "default": "All collections" }] }
{% endschema %}
