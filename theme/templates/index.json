    },
    "b1": {
     "type": "question",
     "settings": {
      "question": "Which grind should I choose?",
      "answer": "<p>Whole bean stays fresh longest. Choose <strong>Filter</strong> for pour-over, drip and French press, and <strong>Espresso</strong> for espresso machines and moka pots.</p>"
     }
    },
    "b2": {
     "type": "question",
     "settings": {
      "question": "Do you offer subscriptions?",
      "answer": "<p>Yes — save 15% with a flexible subscription delivered every 2, 3 or 4 weeks. Skip, swap or cancel any time.</p>"
     }
    },
    "b3": {
     "type": "question",
     "settings": {
      "question": "Is the packaging recyclable?",
      "answer": "<p>Our bags are home-compostable and our boxes are 100% recycled cardboard.</p>"
